DATABASE_URL=sqlite:///./honeybee.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
HOST=0.0.0.0

# Phase 3 LLM Intent Evaluator Configuration (Optional - falls back to deterministic/hybrid engine if omitted)

# DigitalOcean Gemma inference
HONEYBEE_LLM_PROVIDER=digitalocean
DIGITALOCEAN_TOKEN=your_digitalocean_token_here
DIGITALOCEAN_INFERENCE_BASE_URL=https://inference.do-ai.run
DIGITALOCEAN_INFERENCE_MODEL=your_verified_gemma_model_id
DIGITALOCEAN_INFERENCE_TIMEOUT_SECONDS=60

# Application
APP_ENV=development

